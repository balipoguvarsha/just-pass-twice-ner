# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Large Pretrained Weights & Archives (DO NOT COMMIT TO GITHUB)
distilgpt2_model.safetensors
just_pass_twice_datasets.zip

# Large Model Checkpoints (>100MB rejected by GitHub)
checkpoints/*_model.pt
checkpoints/*.bin

# Preserve lightweight adapter heads (<2MB each, fits in GitHub repo)
!checkpoints/heads/
!checkpoints/heads/*.pt

