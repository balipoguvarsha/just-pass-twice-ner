.env
.streamlit/secrets.toml

# IDE & Editor Configurations
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Test & Coverage Outputs
.pytest_cache/
.coverage
htmlcov/

# Logs & Temporary Files
*.log
scratch/
